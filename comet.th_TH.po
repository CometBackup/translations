msgid "The username already exists."
msgstr "ชื่อผู้ใช้นี้มีอยู่แล้ว"

msgid "The value is empty"
msgstr "ค่าว่างเปล่า"

#. Definition of "vhd": A file name extension used for disk image files, usually used with virtual machines. https://en.wikipedia.org/wiki/VHD_(file_format)
#. Definition of "vhdx": A file name extension used for disk image files, usually used with virtual machines. https://en.wikipedia.org/wiki/VHD_(file_format)
#, c-format
